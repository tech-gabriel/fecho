{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Fechô",
  "mainBinaryName": "fecho",
  "version": "1.1.0",
  "identifier": "br.com.fecho.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Fechô",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 680,
        "center": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "wix": {
        "language": {
          "pt-BR": {
            "localePath": "./wix/pt-BR.wxl"
          }
        }
      },
      "nsis": {
        "languages": ["PortugueseBR"]
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "sql": {
      "preload": ["sqlite:fecho.db"]
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDI5NDhDNTZDNTI1NzE4NTYKUldSV0dGZFNiTVZJS2FDd3Q1K0JkZE0rQjlrb0tjZW9RajRtZGZyZ0IwTUtBZTVNeEZETWcrUmkK",
      "endpoints": ["https://github.com/tech-gabriel/fecho/releases/latest/download/latest.json"],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
